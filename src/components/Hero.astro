<section id="hero" class="relative isolate -mt-16 w-full overflow-hidden border-b border-neutral-800/80">
    <!-- Grainient-Canvas; etwas höher als die Sektion, damit beim Parallax kein Rand entsteht -->
    <div id="hero-bg" class="pointer-events-none absolute inset-x-0 -top-[20%] -z-20 h-[140%] will-change-transform"></div>
    <!-- Weicher Übergang zum Seitenhintergrund, damit der Text unten lesbar bleibt -->
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-[#121212]/30 via-transparent to-[#121212]"></div>

    <div class="section-container flex min-h-screen flex-col justify-center border-x-0 pt-16">
        <!-- Name als Punkt-Partikel, die dem Cursor ausweichen (siehe Script).
             Das h1 bleibt für Screenreader/SEO und ist der Fallback ohne JS -->
        <div data-hero class="relative w-full">
            <h1 id="hero-name" class="font-display text-6xl font-black uppercase leading-[0.85] tracking-tight sm:text-7xl md:text-8xl lg:text-9xl">Giulian<br />Giger</h1>
            <canvas id="hero-title" aria-hidden="true" class="hidden w-full"></canvas>
        </div>
    </div>
</section>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { mountGrainient } from '../scripts/grainient';
    import { mountParticleText } from '../scripts/particleText';

    gsap.registerPlugin(ScrollTrigger);

    // Titel-Animation: Name aus Punkten, die dem Cursor ausweichen
    const name = document.getElementById('hero-name');
    const title = document.getElementById('hero-title') as HTMLCanvasElement | null;
    if (name && title && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        name.classList.add('sr-only');
        title.classList.remove('hidden');
        mountParticleText(title, {
            text: 'GIULIAN\nGIGER',
            fontFamily: '"Red Hat Display Variable", system-ui, sans-serif',
            fontWeight: 900,
            maxFontSize: 260,
            lineHeight: 0.85,
            gap: 4,
            dotRadius: 1.1,
            mouseRadius: 55,
            force: 150,
            padding: 200,
        });
    }

    const hero = document.getElementById('hero');
    const bg = document.getElementById('hero-bg');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // WebGL2 nötig – ohne bleibt einfach der normale Seitenhintergrund
    const hasWebGL2 = !!document.createElement('canvas').getContext('webgl2');

    if (hero && bg && hasWebGL2) {
        mountGrainient(bg, {
            // Parameter siehe https://reactbits.dev/backgrounds/grainient
            timeSpeed: 1,
            color1: '#3B5BDB',   // helles Blau (Akzent)
            color2: '#1B2A6B',   // tiefes Navy
            color3: '#0B1026',   // fast schwarz, geht in den Seitenhintergrund über
            grainAmount: 0.12,
            contrast: 1.3,
            zoom: 0.9,
        });

        if (!reduceMotion) {
            // Parallax: Hintergrund scrollt langsamer als der Inhalt und blendet aus
            gsap.to(bg, {
                yPercent: 20,
                opacity: 0,
                ease: 'none',
                scrollTrigger: {
                    trigger: hero,
                    start: 'top top',
                    end: 'bottom top',
                    scrub: true,
                },
            });
        }
    }
</script>
