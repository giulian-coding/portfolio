---
import ProjectCard from './ProjectCard.astro';
import aiRobot from '../assets/3d-stickle-ai-robot-assistant.webm';
import serverCube from '../assets/3d-stickle-network-server-cube-with-colorful-stickers-on-top.webm';
import oldComputer from '../assets/3d-stickle-old-computer-with-stickers.webm';

const projects = [
    {
        title: "Ion - Personal Assistance System",
        description: "In Bearbeitung: Ein internes, performantes Assistenzsystem, das Aufgaben im Home Lab übernehmen kann. Bisher wurde ein leichtgewichtiges Queueing-System eingerichtet, um Jobs persistent durch Worker abarbeiten zu lassen.",
        tags: ["Go", "Concurrency", "NATS"],
        link: "https://github.com/giulian-coding/Ion",
        size: "lg",
        video: aiRobot,
    },
    {
        title: "Zentraler DevOps Skript Server",
        description: "Eine Lösung, die firmeninterne Skripte zentral und versioniert in Azure DevOps speichert und über eine CD-Pipeline auf einen On-Premises-Server kopiert. Dadurch wird die Übersicht über interne Skripte deutlich verbessert.",
        tags: ["DevOps", "YAML", "Windows Server"],
        size: "sm",
        dots: true,
    },
    {
        title: "Azure Files",
        description: "Umsetzung von Azure Files Shares mit automatischer Einbindung über Intune und Authentifizierung via Cloud Kerberos.",
        tags: ["Azure", "Intune", "Client", "Kerberos"],
        size: "sm",
        dots: true,
    },
    {
        title: "Portfolio",
        description: "Ein Portfolio, das meine Fähigkeiten als IT System Engineer und Software Engineer präsentiert. Gehostet wird es auf Cloudflare und entwickelt wurde es mit dem Astro Framework.",
        tags: ["Web", "Astro", "Cloudflare"],
        link: "https://github.com/giulian-coding/portfolio",
        size: "md",
    },
    {
        title: "Containers",
        description: "Ein leichtgewichtiger Docker-Klon, der in Linux-Umgebungen läuft.",
        tags: ["Go", "Low-Level", "Linux"],
        link: "https://github.com/giulian-coding/Containers",
        size: "md",
        video: serverCube,
    },
] as const;
---

<div data-reveal="stagger" class="grid grid-cols-1 gap-4 md:grid-cols-6 md:auto-rows-[minmax(220px,auto)]">
    {projects.map((p) => (
        <ProjectCard {...p} />
    ))}
</div>
