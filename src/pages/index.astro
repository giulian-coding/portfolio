---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/AboutMe.astro';
import Section from '../components/Section.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
	<Hero />

	<Section id="about">
		<h2 class="mb-8 text-3xl font-semibold tracking-tight">Über mich</h2>
		<AboutMe />
	</Section>

	<Section id="projects">
		<h2 data-reveal class="mb-8 text-3xl font-semibold tracking-tight">Projekte</h2>
		<Projects />
	</Section>

	<Section id="skills">
		<h2 data-reveal class="mb-8 text-3xl font-semibold tracking-tight">Tech Stack</h2>
		<TechStack />
	</Section>

	<Section id="contact">
		<h2 class="mb-8 text-3xl font-semibold tracking-tight">Kontakt</h2>
		<Contact />
	</Section>
</Layout>
