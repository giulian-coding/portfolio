// Cloudflare Workers – Konfiguration für das statische Astro-Build.
// Kein SSR-Adapter nötig: Wrangler liefert das dist/-Verzeichnis als Static Assets aus.
// Deploy: npm run build && npx wrangler deploy
{
  "name": "portfolio",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
